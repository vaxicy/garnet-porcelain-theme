  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#AEC4D4",
    "method": "#AEC4D4",
    "class": "#C6B5CE",
    "type": "#C6B5CE",
    "string": "#A9C8B5",
    "number": "#E5D3AF",
    "keyword": "#E59A9F",
    "comment": "#89959D"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#89959D"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#E59A9F"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A9C8B5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E5D3AF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C6B5CE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#AEC4D4"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EDE6D9"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E59A9F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EAC18C"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#E59A9F"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E69DA8"
      }
    }
  ]
