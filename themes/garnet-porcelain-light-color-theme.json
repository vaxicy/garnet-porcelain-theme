  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#426A86",
    "method": "#426A86",
    "class": "#79627E",
    "type": "#79627E",
    "string": "#476C63",
    "number": "#86632D",
    "keyword": "#790D16",
    "comment": "#817B71"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#817B71"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#790D16"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#476C63"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#86632D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#79627E"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#426A86"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#403B36"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#790D16"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#86632D"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#790D16"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#AB4858"
      }
    }
  ]
}
